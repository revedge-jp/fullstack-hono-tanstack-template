{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "workspaces": {
    "apps/api-service": {
      "entry": ["src/index.ts", "src/app.ts", "src/test-helpers/create-fake-app.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/client": {
      "entry": ["app/**/*.{ts,tsx}", "features/**/*.{ts,tsx}", "shared/**/*.{ts,tsx}"],
      "project": ["**/*.{ts,tsx}"]
    }
  },
  "ignore": ["apps/api-service/src/__tests__/**", "apps/api-service/src/**/*.test.ts"],
  "ignoreFiles": ["steiger.config.mjs"],
  "ignoreIssues": {
    "apps/client/components/ui/**": ["exports", "types"],

    "packages/typescript-config/*.json": ["unresolved"],
    "apps/api-service/src/app.ts": ["types"],
    "packages/result/src/index.ts": ["exports"]
  },
  "ignoreDependencies": [
    "@tailwindcss/postcss",
    "@tailwindcss/vite",
    "tailwindcss",
    "vite-tsconfig-paths",
    "@repo/tailwind-config",
    "tw-animate-css",
    "@feature-sliced/steiger-plugin",
    "@prisma/client",
    "pino-pretty"
  ],
  "ignoreBinaries": ["gsutil", "playwright"]
}
