{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "workspaces": {
    ".": {
      "entry": ["alchemy.run.ts"]
    },
    "apps/api-service": {
      "entry": ["src/index.ts", "src/features/**/*.ts", "src/__tests__/**/*.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/client": {
      "entry": ["app/**/*.{ts,tsx}", "features/**/*.test.{ts,tsx}"],
      "project": ["**/*.{ts,tsx}"]
    }
  },
  "ignoreFiles": ["steiger.config.mjs"],
  "ignoreIssues": {
    "apps/client/components/ui/**": ["exports", "types", "files"],

    "packages/typescript-config/*.json": ["unresolved"],
    "apps/api-service/src/app.ts": ["types"]
  },
  "ignoreDependencies": [
    "@tailwindcss/postcss",
    "tailwindcss",
    "@repo/tailwind-config",
    "tw-animate-css",
    "@feature-sliced/steiger-plugin",
    "pino-pretty",
    "@stryker-mutator/command-runner"
  ]
}
