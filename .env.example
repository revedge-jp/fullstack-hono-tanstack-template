# ============================================
# Environment
# ============================================
# ローカル開発では必ず development を明示する。未設定は production として扱われ(fail-closed)、
# CORS_ORIGIN 等の本番必須検証で起動時にエラーになる(dev-auth も無効)。
# テスト実行時は root の test / test:integration スクリプトが NODE_ENV=test で上書きする
# (Better Auth が process.env.NODE_ENV を直接参照し、development だと一部挙動が変わるため)。
NODE_ENV=development

# ============================================
# Database
# ============================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_db
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/app_db

# ============================================
# Docker Compose
# ============================================
# 他プロジェクトとボリュームを共有しない（postgres-data 競合回避）
POSTGRES_VOLUME_NAME=app-postgres-data
# コンテナ名（他プロジェクトと衝突する場合に上書き。既定は app_postgres 系）
# POSTGRES_CONTAINER_NAME=app_postgres
# POSTGRES_TEST_CONTAINER_NAME=app_postgres_test
# PGADMIN_CONTAINER_NAME=app_pgadmin

# ============================================
# Auth (Better Auth)
# ============================================
# 以下はダミー値のままでも config.ts のバリデーションを通過し、dev サーバーは起動する。
# ローカルのサインインは「Dev サインイン」ボタン（/api/dev/login。開発時のみ表示）で
# Google を介さず可能。実際の Google サインインを試す場合のみ、GOOGLE_CLIENT_ID /
# GOOGLE_CLIENT_SECRET に本物の OAuth クレデンシャルを設定すること。
BETTER_AUTH_SECRET=your-secret-here
BETTER_AUTH_URL=http://localhost:8080
# 開発時: クライアントのオリジン（本番は不要）
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ============================================
# API Service (apps/api-service)
# ============================================
LOG_PRETTY=false
# ログレベル（fatal/error/warn/info/debug/trace/silent）。未設定時は環境別デフォルト（開発: debug、本番: info）
# LOG_LEVEL="debug"
# API サーバーのポート。未設定で 8080 がデフォルト
# API_PORT=8080
# 本番では必須。開発時は未設定で http://localhost:3000 がデフォルト
# CORS_ORIGIN=http://localhost:3000
# リクエストタイムアウト（ms）。未設定で 30000
# REQUEST_TIMEOUT_MS=30000
# 認証ルート（/api/auth/*）のレートリミット。未設定で 60000ms あたり 20 リクエスト
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=20
# /api/health が返すビルド情報。CI が注入する（ローカルは未設定で "dev"）
# APP_VERSION=dev
# GIT_SHA=dev

# ============================================
# Client (apps/client)
# ============================================
# クライアントのポート。未設定で 3000 がデフォルト
# CLIENT_PORT=3000
# API サーバーの URL。未設定で http://localhost:8080 がデフォルト
# API_BASE_URL=http://localhost:8080

# ============================================
# Infra (Alchemy — docs/dev/alchemy-iac.md)
# ============================================
# 【原則】このセクションはローカルから bun run infra:deploy:* を叩く場合のみ必要。
# 通常運用のデプロイは CI（GitHub Environments）が担うため、staging/production の
# 資格情報をローカルに保存し続けないこと。CI 側の設定は:
#   bash scripts/setup-deploy-env.sh staging
# Worker / Hyperdrive の命名に使うアプリ名（init-template.sh の APP_NAME と同じ値）
# APP_NAME=my-app
# Alchemy state 内の secrets 暗号化パスワード（任意の強い文字列）
# ALCHEMY_PASSWORD=change-me
# Alchemy state store（CF 上の Durable Object）の認証トークン。
# CI（GitHub Environment Secrets）とローカルで必ず同一の値にすること
# ALCHEMY_STATE_TOKEN=change-me-too
# PlanetScale（DB は alchemy が作成する — docs/dev/alchemy-iac.md）
# サービストークンは PlanetScale ダッシュボード → Organization settings → Service tokens で発行
# PLANETSCALE_ORGANIZATION=your-org
# PLANETSCALE_SERVICE_TOKEN_ID=
# PLANETSCALE_SERVICE_TOKEN=
# デプロイ後の公開 URL（BETTER_AUTH_URL / CORS_ORIGIN に使用）。
# CUSTOM_DOMAIN → APP_ORIGIN → WORKERS_SUBDOMAIN（workers.dev URL を組み立て）の順で解決
# APP_ORIGIN=https://my-app-staging.example.workers.dev
# WORKERS_SUBDOMAIN=your-account-subdomain
# Cloudflare 認証（wrangler login 済みなら不要）
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# --- オプション機能（カスタムドメイン運用時のみ — alchemy.run.ts のコメント参照） ---
# Worker に割り当てるホスト名（zone が CF アカウントにあること。DNS/TLS は自動設定）
# CUSTOM_DOMAIN=app.example.com
# エッジ（WAF）での /api/* レート制限（IP ごとの分間リクエスト数）。CUSTOM_DOMAIN 必須。
# zone の http_ratelimit フェーズを専有する点に注意（zone 共有時は 1 stage のみで設定）
# EDGE_RATE_LIMIT_RPM=300
# Worker trace ログの Logpush 宛先（Workers Paid プラン必須）
# LOGPUSH_DESTINATION=r2://bucket/path?account-id=...&access-key-id=...&secret-access-key=...
