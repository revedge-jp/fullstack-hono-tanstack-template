# ============================================
# Database
# ============================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_db
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/app_db

# ============================================
# Docker Compose
# ============================================
# 他プロジェクトとボリュームを共有しない（postgres-data 競合回避）
POSTGRES_VOLUME_NAME=app-postgres-data
POSTGRES_TEST_VOLUME_NAME=app-postgres-test-data

# ============================================
# Auth (Better Auth)
# ============================================
BETTER_AUTH_SECRET=your-secret-here
BETTER_AUTH_URL=http://localhost:8080
# 開発時: クライアントのオリジン（本番は不要）
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
RESEND_API_KEY=your-resend-api-key

# ============================================
# API Service (apps/api-service)
# ============================================
LOG_PRETTY=false
# ログレベル（fatal/error/warn/info/debug/trace/silent）。未設定時は環境別デフォルト（開発: debug、本番: info）
# LOG_LEVEL="debug"
# API サーバーのポート。未設定で 8080 がデフォルト
# API_PORT=8080
# 本番では必須。開発時は未設定で http://localhost:3000 がデフォルト
# CORS_ORIGIN=http://localhost:3000

# ============================================
# Client (apps/client)
# ============================================
# クライアントのポート。未設定で 3000 がデフォルト
# CLIENT_PORT=3000
# API サーバーの URL。未設定で http://localhost:8080 がデフォルト
# API_BASE_URL=http://localhost:8080
