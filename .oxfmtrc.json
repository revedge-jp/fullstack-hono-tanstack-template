{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 100,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "endOfLine": "lf",
  "sortImports": true,
  "sortTailwindcss": {
    "stylesheet": "apps/client/app/globals.css",
    "functions": ["clsx", "cva", "tw", "cn"],
    "attributes": ["classList"]
  },
  "ignorePatterns": [
    "**/*.gen.ts",
    "**/*.gen.tsx",
    "**/ui-shadcn/**",
    "apps/client/components/ui/**",
    "**/*.md",
    "**/*.yml",
    "**/*.yaml"
  ]
}
