{
  "name": "api-service",
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "default": "./src/app.ts"
    },
    "./test-helpers": {
      "types": "./dist/test-helpers/create-fake-app.d.ts",
      "default": "./src/test-helpers/create-fake-app.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json --emitDeclarationOnly",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly",
    "dev": "dotenv -e ../../.env -- bun run --hot src/index.ts",
    "lint": "biome check .",
    "lint:fix": "biome check . --write --unsafe",
    "typecheck": "tsc --noEmit",
    "test": "sh -c 'files=$(find src -name \"*.test.ts\" 2>/dev/null | head -1); [ -z \"$files\" ] || bun test'",
    "test:unit": "bun test src/features src/__tests__/unit",
    "test:watch": "bun test --watch",
    "test:integration": "bun test src/__tests__/integration",
    "test:contract": "bun test src/__tests__/contract",
    "coverage": "bun test --coverage",
    "coverage:unit": "bun test --coverage src/__tests__/unit src/features",
    "coverage:integration": "bun test --coverage src/__tests__/integration",
    "dep:cycles": "madge src --ts-config tsconfig.json --extensions ts --circular --exclude 'node_modules|dist|generated'",
    "dep:orphans": "madge src/index.ts --ts-config tsconfig.json --extensions ts --orphans --exclude 'node_modules|dist|generated|(^|/)__tests__($|/)|(^|/).*\\.test\\.ts$|(^|/)src/index\\.ts$'",
    "dep:graph": "madge src --ts-config tsconfig.json --extensions ts --image ../../docs/server-deps.svg --exclude 'node_modules|dist|generated'"
  },
  "dependencies": {
    "@repo/db": "workspace:*",
    "@repo/logging": "workspace:*",
    "@repo/result": "workspace:*",
    "better-auth": "^1.5.5",
    "hono": "^4.12.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "5.9.3"
  }
}
