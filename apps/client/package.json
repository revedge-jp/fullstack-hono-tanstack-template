{
  "name": "client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- sh -c 'exec vite --port ${CLIENT_PORT:-3000}'",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check . --write --unsafe",
    "test": "bun test features shared",
    "test:unit": "bun test features shared",
    "typecheck": "tsc --noEmit",
    "dep:cycles": "madge app --ts-config tsconfig.json --extensions ts,tsx --circular --exclude 'node_modules|.output|dist|routeTree\\.gen'",
    "dep:orphans": "madge app/router.tsx --ts-config tsconfig.json --extensions ts,tsx --orphans --exclude 'node_modules|.output|dist'",
    "dep:graph": "madge app --ts-config tsconfig.json --extensions ts,tsx --image ../../docs/client-deps.svg --exclude 'node_modules|.output|dist'"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-query": "^5.74.4",
    "@tanstack/react-router": "^1.114.23",
    "@tanstack/react-router-with-query": "^1.114.23",
    "@tanstack/react-start": "^1.114.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.12.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwind-merge": "^3.4.0",
    "vite": "8",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@repo/tailwind-config": "workspace:*",
    "@tailwindcss/vite": "^4.1.17",
    "@tanstack/react-router-devtools": "^1.166.7",
    "@types/bun": "latest",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.4",
    "@types/react": "^19",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.2.0",
    "api-service": "workspace:*",
    "pg": "^8.18.0",
    "tailwindcss": "^4.1.17",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
