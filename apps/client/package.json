{
  "name": "client",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../../.env -- sh -c 'exec next dev --port ${CLIENT_PORT:-3000}'",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check . --write --unsafe",
    "test": "bun test features shared",
    "test:unit": "bun test features shared",
    "typecheck": "tsc --noEmit",
    "dep:cycles": "madge app --ts-config tsconfig.json --extensions ts,tsx --circular --exclude 'node_modules|.next|dist'",
    "dep:orphans": "madge app/layout.tsx app/page.tsx --ts-config tsconfig.json --extensions ts,tsx --orphans --exclude 'node_modules|.next|dist'",
    "dep:graph": "madge app --ts-config tsconfig.json --extensions ts,tsx --image ../../docs/client-deps.svg --exclude 'node_modules|.next|dist'",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.12.2",
    "next": "16.1.6",
    "postcss": "^8.5.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@playwright/test": "1.58.2",
    "@types/pg": "^8.15.4",
    "pg": "^8.18.0",
    "api-service": "workspace:*",
    "@repo/tailwind-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^24.10.0",
    "@types/react": "^19",
    "@types/react-dom": "^19.2.2",
    "tailwindcss": "^4.1.17",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
