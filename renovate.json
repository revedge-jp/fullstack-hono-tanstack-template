{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests"
  ],
  "labels": ["dependencies"],
  "timezone": "Asia/Tokyo",
  "schedule": ["before 9am on monday"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "ignorePaths": ["**/node_modules/**", "temp/**"],
  "minimumReleaseAge": "3 days",
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["before 9am on monday"]
  },
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "automerge": false,
    "schedule": ["at any time"],
    "minimumReleaseAge": "3 days",
    "prCreation": "immediate"
  },
  "packageRules": [
    {
      "description": "devDependencies の patch/minor は自動マージ（本番実行コードに影響しない）",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true
    },
    {
      "description": "GitHub Actions は SHA ピンを維持しつつ digest/patch/minor を自動マージ（実行ロジックではなく CI ツール）",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["digest", "pin", "patch", "minor"],
      "automerge": true
    },
    {
      "description": "本番 dependencies は実行時挙動に影響しうるため自動マージせずレビュー",
      "matchDepTypes": ["dependencies"],
      "automerge": false
    },
    {
      "description": "AI 文章チェックの辞書（ui-copy.mjs / lint:prose の判定そのもの）。語が消える更新はガードを緩めても CI が通るので、自動マージせず差分を見てマージする。lockFileMaintenance（自動マージ）で範囲内の新しい版が入らないよう、package.json では版を固定している",
      "matchPackageNames": [
        "textlint-rule-preset-ai-words-ja",
        "@textlint-ja/textlint-rule-preset-ai-writing"
      ],
      "automerge": false
    },
    {
      "description": "0.x の依存は minor でも破壊的変更が入りうる（semver では 0.93 → 0.94 が minor 扱いになる）ので、devDependencies でも自動マージしない（範囲指定のものは、範囲内の patch が lockFileMaintenance で入る）",
      "matchCurrentVersion": "<1.0.0",
      "automerge": false
    },
    {
      "description": "デプロイ経路のツールは、壊れても CI では出ず main マージ後の staging デプロイで初めて表に出る（alchemy.run.ts は CI で動かない）ので、自動マージしない。lockFileMaintenance（自動マージ）には packageRules が効かないので、package.json では版を完全一致で固定している",
      "matchPackageNames": ["alchemy", "drizzle-kit", "wrangler", "@cloudflare/vite-plugin"],
      "automerge": false
    },
    {
      "description": "major は常にレビュー必須（自動マージしない）",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "addLabels": ["major-update"]
    }
  ]
}
