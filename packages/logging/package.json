{
  "name": "@repo/logging",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*"
  },
  "typesVersions": {
    "*": {
      "*": [
        "src/*"
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check . --write --unsafe"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "pino-pretty": "^13.1.3",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@google-cloud/pino-logging-gcp-config": "^1.3.1",
    "pino": "^10.3.1"
  }
}
