{
  "name": "@repo/logging",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*"
  },
  "typesVersions": {
    "*": {
      "*": [
        "src/*"
      ]
    }
