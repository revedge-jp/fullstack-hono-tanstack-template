    "test:unit": "bun test src"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/bun": "^1.3.13",
    "pino-pretty": "^13.1.3",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "pino": "^10.3.1"
  }
}
