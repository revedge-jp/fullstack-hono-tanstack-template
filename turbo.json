{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalDependencies": [".oxlintrc.json", ".oxfmtrc.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".output/**", "dist/**"],
      "env": ["DATABASE_URL"]
    },

    "typecheck": {
      "dependsOn": ["^build", "^typecheck"]
    },
    "client#typecheck": {
      // client は api-service を workspace 依存に持つため、^build だけで api-service#build
      // (= dist/app.d.ts の宣言生成)が保証される。以前はここに api-service#build:types も
      // 明示していたが、build:types は build と同一コマンドで同じ dist/app.d.ts へ書くため、
      // 順序依存の無い2タスクが並列実行され同一ファイルへ同時書き込みして .d.ts を壊す
      // 競合を生んでいた(client#typecheck がランダムに TS1131/TS1109 で落ちる)。
      // build:types を廃止し ^build 一本に統一することで、dist/app.d.ts を書く tsc は常に1つになる。
      "dependsOn": ["^build", "^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["DATABASE_URL", "LOG_LEVEL"]
    },
    "lint": {},
    "client#lint": {
      // type-aware lint(oxlint-tsgolint)は api-service の dist/app.d.ts(AppType)を参照する。
      // dist が無いと Hono RPC 呼び出しの型が解決できず no-floating-promises が黙って空振りするため、
      // typecheck と同じく ^build を先行させる。
      "dependsOn": ["^build"]
    },
    "lint:fix": { "cache": false },
    "client#lint:fix": { "cache": false, "dependsOn": ["^build"] },
    "test": {
      "cache": false,
      "dependsOn": ["^test"],
      "env": ["DATABASE_URL"]
    },
    "test:unit": {
      "cache": false,
      "dependsOn": ["^test:unit"]
    },
    "test:integration": {
      "cache": false,
      "dependsOn": ["^test:integration"],
      "env": ["DATABASE_URL"]
    },
    "test:contract": {
      "cache": false,
      "dependsOn": ["^test:contract"]
    },
    "coverage:unit": {
      "cache": false,
      "dependsOn": ["^coverage:unit"]
    },
    "coverage:integration": {
      "cache": false,
      "dependsOn": ["^coverage:integration"],
      "env": ["DATABASE_URL"]
    },
    "dep:cycles": {},
    "dep:orphans": {},
    "dep:graph": {},
    "//#legacy-aliases": {}
  }
}
